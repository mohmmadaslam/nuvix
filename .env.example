# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# Native Postgres 17 (via Homebrew), database created as `audio_search`.
# Default Homebrew Postgres has no password for local trust-auth connections.
DATABASE_URL=postgresql://localhost:5432/audio_search

# Hugging Face access token, required for pyannote/speaker-diarization-3.1
# (gated model). Create a token at https://huggingface.co/settings/tokens
# and accept the model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
# (both must be accepted while logged in as the same account as the token).
HF_TOKEN=
