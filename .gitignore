# OS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# REVISED 2026-09-26: repo is going public, so raw source videos are
# excluded entirely (not CC-licensed - see docs/ARCHITECTURE.md Section 2)
# and were purged from git history via filter-branch. Never re-add
# data/videos/*.mp4 to git. Extracted audio (data/audio/*.wav) is kept
# and committed - that's the actual pipeline input, not the raw source.
data/videos/*.mp4

# Env / secrets
.env
*.env.local

# Model caches
.cache/

# Derived, regenerable pipeline intermediate outputs (transcripts,
# diarization, embeddings, etc.) - not committed, reproducible from
# data/videos + data/manifest.yaml + ingest/ code.
data/pipeline/
